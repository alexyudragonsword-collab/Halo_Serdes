examples/output/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# compiled reference IBIS-AMI model (built on demand)
src/halo_serdes/io/ami_c/*.so
src/halo_serdes/io/ami_c/*.dll
src/halo_serdes/io/ami_c/*.dylib

# coverage artifacts
.coverage
.coverage.*
htmlcov/

# Android build outputs + the host-generated probe golden (regenerated per
# build on purpose: a committed constant would rot and defeat the comparison)
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/python/probe_golden.json

# setuptools / wheel build trees. `build-android-wheel/` is the work tree the
# Cython cross-compile script creates when run from the repo root; both are
# regenerated per build and neither belongs in history.
build/
build-android-wheel/
dist/
